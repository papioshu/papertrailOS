# --- Database (Supabase Postgres, used by Prisma) ---
# Pooled connection (PgBouncer, port 6543) for the app at runtime.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) for migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# --- Auth (NextAuth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"
# 32-byte key (base64) for encrypting stored provider credentials. openssl rand -base64 32
ENCRYPTION_KEY=""
DEFAULT_SEND_CAP="25"

# --- Model provider (server-only; one is enough) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Lead sources (optional; routes fail gracefully if absent) ---
GOOGLE_PLACES_API_KEY=""
# Event/content lead search (Google Programmable Search). Both required.
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""

# --- Automation ---
# Bearer token so an external scheduler can POST /api/automation/run-lead-trail.
AUTOMATION_TOKEN=""

# --- Gmail (Phase 5; optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"
