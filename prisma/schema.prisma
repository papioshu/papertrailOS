// Papertrail OS — foundation schema (Phase 1).
// DB: Supabase Postgres. ORM: Prisma. Profile isolation is enforced in app
// code (Prisma query scoping + server guards), not RLS, per stack decision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  super_admin
  profile_admin
  profile_member
  viewer
}

// Outreach safety posture for a profile. Default keeps sending off.
enum AgentMode {
  draft_only
  manual_approval
  controlled_send
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String?
  passwordHash String
  // Paper / Papers developer account: access to every profile.
  isSuperAdmin Boolean             @default(false)
  memberships  ProfileMembership[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model Profile {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  tagline     String?
  // Hex accent used by the profile card / workflow chrome.
  accent      String              @default("#8b5cf6")
  memberships ProfileMembership[]
  identity    BusinessIdentity?
  settings    ProfileSettings?
  campaigns   Campaign[]
  leads       Lead[]
  gmail       GmailConnection?
  sendQueue   SendQueue[]
  replies     Reply[]
  followups   Followup[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProfileMembership {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  role      Role     @default(profile_member)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, profileId])
  @@index([profileId])
}

// Required before any commercial email can send (CAN-SPAM identity + opt-out).
model BusinessIdentity {
  id            String   @id @default(cuid())
  profileId     String   @unique
  legalName     String?
  fromName      String?
  fromEmail     String?
  phone         String?
  website       String?
  postalAddress String?
  optOutText    String?
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProfileSettings {
  id             String    @id @default(cuid())
  profileId      String    @unique
  agentMode      AgentMode @default(draft_only)
  dailySendCap   Int       @default(25)
  manualApproval Boolean   @default(true)
  sendWindow     String?   // e.g. "09:00-17:00"
  businessDaysOnly Boolean @default(true)
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Campaign {
  id         String   @id @default(cuid())
  profileId  String
  name       String
  niche      String?
  city       String?
  state      String?
  sourceType String   @default("manual")
  offerLane  String?
  status     String   @default("active")
  maxLeads   Int      @default(50)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  leads      Lead[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profileId])
}

// A lead/prospect record. status follows the CRM pipeline (see LEAD_STATUSES
// in src/lib/leadStatus.ts). Dedup is enforced in app code, not unique
// constraints, since the match is fuzzy (website / email / phone / name+addr).
model Lead {
  id             String    @id @default(cuid())
  profileId      String
  campaignId     String?
  businessName   String
  category       String?
  address        String?
  city           String?
  state          String?
  phone          String?
  website        String?
  email          String?
  googleRating   Float?
  reviewCount    Int?
  instagram      String?
  facebook       String?
  tiktok         String?
  linkedin       String?
  lastSocialPost String?
  offerAngle     String?
  decisionMaker  String?
  leadScore      Int?
  suggestedMessage String?
  source         String    @default("manual")
  sourceUrl      String?
  status         String    @default("New")
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  audits         WebsiteAudit[]
  drafts         OutreachDraft[]
  sendItems      SendQueue[]
  replies        Reply[]
  followups      Followup[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([profileId])
  @@index([campaignId])
}

// A generated outreach draft for one lead + channel. Most recent per channel
// is current (enforced by the unique constraint). Nothing sends from here in
// Phase 4 — drafts are composed, compliance-checked, edited, and approved.
model OutreachDraft {
  id               String    @id @default(cuid())
  profileId        String
  leadId           String
  channel          String    // email | dm | call | followup1 | followup2
  subject          String?
  body             String
  approachType     String    @default("soft")
  providerUsed     String    @default("template")
  complianceStatus String    @default("pending") // pending | pass | fail
  complianceRisk   String?
  complianceJson   Json?
  approved         Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  sentAt           DateTime?
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sendItems        SendQueue[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([leadId, channel])
  @@index([profileId])
}

// Per-profile Gmail authorization for creating drafts / controlled sending.
// Tokens are profile-scoped and server-only.
model GmailConnection {
  id           String    @id @default(cuid())
  profileId    String    @unique
  email        String
  refreshToken String
  accessToken  String?
  expiry       DateTime?
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// One outreach send attempt. The queue is the single audited path to Gmail —
// nothing sends outside it, and a (draftId) send is never duplicated.
model SendQueue {
  id            String    @id @default(cuid())
  profileId     String
  leadId        String
  draftId       String
  channel       String
  status        String    @default("queued") // queued | drafted | sent | failed | blocked
  gmailDraftId  String?
  gmailMessageId String?
  gmailThreadId String?
  error         String?
  attempts      Int       @default(0)
  sentAt        DateTime?
  profile       Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lead          Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  draft         OutreachDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([profileId])
  @@index([leadId])
}

// One website audit run for a lead. The most recent row is the current audit.
model WebsiteAudit {
  id                    String   @id @default(cuid())
  profileId             String
  leadId                String
  reachable             Boolean  @default(true)
  websiteScore          Int
  mobileScore           Int
  seoScore              Int
  conversionScore       Int
  trustScore            Int
  contentScore          Int
  summary               String
  findingsJson          Json
  recommendedOfferAngle String?
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())

  @@index([leadId])
  @@index([profileId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  profileId String?
  userId    String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([profileId])
}

// An inbound reply detected by Reply Radar (Gmail thread sync). One row per
// inbound Gmail message; classification drives the lead's next CRM state.
model Reply {
  id             String   @id @default(cuid())
  profileId      String
  leadId         String
  sendQueueId    String?
  gmailMessageId String   @unique
  gmailThreadId  String?
  fromEmail      String
  snippet        String
  classification String   @default("Unknown")
  receivedAt     DateTime
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([profileId])
  @@index([leadId])
}

// A scheduled follow-up touch. The follow-up runner sends due items through
// the same send guard; reply/opt-out/DNC/closed cancel pending follow-ups.
model Followup {
  id           String    @id @default(cuid())
  profileId    String
  leadId       String
  channel      String    // followup1 | followup2
  scheduledFor DateTime
  status       String    @default("scheduled") // scheduled | sent | skipped | canceled
  sentAt       DateTime?
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([leadId, channel])
  @@index([profileId])
}
